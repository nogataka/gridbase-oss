# gridbase — 環境変数の例
#
#   cp .env.example .env && docker compose up -d
#
# この例の値は「ローカルで試すためのダミー」です。そのまま起動できますが、
# ポートは 127.0.0.1 にだけ公開されます（GRIDBASE_BIND_ADDRESS）。
# インターネットに公開する前に、秘密の値をすべて作り直してください。
#   強いランダム値の作り方:  openssl rand -hex 32
#   NEXTAUTH_SECRET の例:    openssl rand -base64 32

# ---------------------------------------------------------------------------
# ドメインと URL
# ---------------------------------------------------------------------------

# トンネルのベースドメイン。foo.<この値> が foo トンネルの公開 URL になります。
# gridbase.localhost は *.gridbase.localhost が 127.0.0.1 に解決されるので DNS 設定不要です
# （curl・主要ブラウザ。OS によっては解決されないことがあります。README のトラブルシュート参照）。
GRIDBASE_BASE_DOMAIN=gridbase.localhost

# 管理画面のホスト名。本番ではトンネルとは別の登録可能ドメインを推奨します（例 admin.example.org）。
GRIDBASE_ADMIN_DOMAIN=admin.gridbase.localhost

# 管理画面にブラウザからアクセスする URL（末尾スラッシュなし。ポートを変えたら含める）。
# NextAuth のコールバック・Origin 検査・Secure Cookie に使うので、ブラウザで開く URL と完全一致させます。
GRIDBASE_ADMIN_URL=http://admin.gridbase.localhost

# Caddy のサイトアドレスのスキーム。ローカルは http://、本番(自動 HTTPS)は https://
GRIDBASE_SITE_SCHEME=http://

# ダッシュボードに表示する、トンネルクライアントの接続先 host:port
GRIDBASE_TUNNEL_SERVER=localhost:9443

# ---------------------------------------------------------------------------
# ホストに公開するポート
# ---------------------------------------------------------------------------

# 公開するネットワークインターフェース。ローカル検証は 127.0.0.1、
# 外部公開は 0.0.0.0（秘密を作り直してから）。
GRIDBASE_BIND_ADDRESS=127.0.0.1

# Caddy の HTTP / HTTPS。ホスト側で 80 / 443 が使用中なら変更します（例 8080 / 8443）。
# 変更したら GRIDBASE_ADMIN_URL にもポートを含めてください（例 http://admin.gridbase.localhost:8080）。
GRIDBASE_HOST_HTTP_PORT=80
GRIDBASE_HOST_HTTPS_PORT=443

# トンネルポート（gridbase クライアントが接続する）。Caddy を通さず直接公開されます。
GRIDBASE_HOST_TUNNEL_PORT=9443

# ---------------------------------------------------------------------------
# Directus
# ---------------------------------------------------------------------------

# Directus 内部用の鍵（KEY は一意な文字列、SECRET はトークン署名用）
DIRECTUS_KEY=local-dev-directus-key-0000000000000001
DIRECTUS_SECRET=local-dev-directus-secret-000000000000000002

# Directus 管理者（Directus の管理 UI にログインするため。gridbase の管理者とは別物です）
DIRECTUS_ADMIN_EMAIL=directus-admin@example.com
DIRECTUS_ADMIN_PASSWORD=local-dev-directus-admin-password

# Directus 管理者の静的トークン。directus-init がスキーマ適用・権限作成に使います。
# 3 つのトークン（これと下の 2 つ）は別々の値にしてください。
DIRECTUS_ADMIN_TOKEN=local-dev-directus-admin-token-00000000001

# 最小権限のサービストークン（init が Directus のサービスユーザーに設定します）
#   web    : users / subdomains の読み書き
#   tunnel : users / subdomains の読み取りのみ
GRIDBASE_WEB_DIRECTUS_TOKEN=local-dev-gridbase-web-token-00000000002
GRIDBASE_TUNNEL_DIRECTUS_TOKEN=local-dev-gridbase-tunnel-token-0000000003

# ---------------------------------------------------------------------------
# 管理画面 (web)
# ---------------------------------------------------------------------------

# セッション JWT の署名鍵
NEXTAUTH_SECRET=local-dev-nextauth-secret-0000000000000000004

# 初回管理者（users に admin が 1 人もいないとき、起動時に 1 回だけ作成されます）。
# パスワードは 8 文字以上。作成後は .env から消して構いません（保存済みの管理者パスワードが既定のままでないかの検査は、
# 消しても directus-init が行います。公開構成で既定のままなら起動しません）。
GRIDBASE_ADMIN_EMAIL=admin@gridbase.localhost
GRIDBASE_ADMIN_PASSWORD=ChangeMe-local-1234

# true で新規登録を公開。既定は閉鎖（管理者がユーザーを招待する運用）。
GRIDBASE_SIGNUP_ENABLED=false

# パスワードリセット用 SMTP（任意）。SMTP_HOST と SMTP_FROM が両方あるときだけ有効。
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---------------------------------------------------------------------------
# トンネルサーバー
# ---------------------------------------------------------------------------

# トンネルの管理 API の Bearer トークン。管理 API は compose 内部からのみ到達できます（web は使いません）。
# 空にすると管理 API は無効です。使う場合は 24 文字以上のランダム値にしてください。
# change-me / local-dev- / replace-with- で始まる値のままだと、管理 API は無効のまま起動します（ここの既定値がそれです）。
GRIDBASE_TUNNEL_ADMIN_TOKEN=local-dev-tunnel-admin-token-0000000005

# 任意の調整値（空なら tunnel の既定値。意味と既定値は tunnel/README.md の設定表）
# GRIDBASE_TUNNEL_MAX_FRAME_BYTES=
# GRIDBASE_TUNNEL_HANDSHAKE_TIMEOUT=
# GRIDBASE_HTTP_MAX_REQUEST_BODY_BYTES=
# GRIDBASE_HTTP_MAX_RESPONSE_BODY_BYTES=
# 前段のプロキシ（同梱の Caddy 以外を使う場合）の IP/CIDR をカンマ区切りで。ip_allow_list の判定に使われます
# GRIDBASE_HTTP_TRUSTED_PROXIES=

# ---------------------------------------------------------------------------
# Postgres（任意。docker-compose.postgres.yml を重ねたときだけ使われます）
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=local-dev-postgres-password-0000006
