# GridBase web (admin console) — 環境変数の例
# 値はすべてダミーです。実際の値で .env を作り、リポジトリにはコミットしないでください。
# NEXT_PUBLIC_* は使いません。すべて実行時（コンテナ起動時）に読まれるため、
# ビルド後のイメージに対して環境変数だけで設定を変えられます。

# ---- 必須 ----

# 管理画面の公開 URL（末尾スラッシュなし）。NextAuth とパスワードリセットのリンクに使います。
# https:// のときだけ HSTS / upgrade-insecure-requests / Secure Cookie が有効になります。
# （APP_URL でも指定可。両方ある場合は NEXTAUTH_URL が優先）
NEXTAUTH_URL=https://admin.example.com

# セッション JWT の署名鍵。例: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-to-a-long-random-string

# Directus の URL（compose 内なら http://directus:8055）
DIRECTUS_URL=http://directus:8055

# Directus の静的トークン。users / subdomains コレクションだけを操作できる
# 最小権限のユーザー用トークンを使ってください（管理者トークンは使わない）。
DIRECTUS_TOKEN=change-me-directus-static-token

# ---- 表示用（任意）----

# サブドメインの公開 URL 表示に使うベースドメイン。例: foo → foo.example.com
GRIDBASE_BASE_DOMAIN=example.com

# トンネルクライアントの接続先（host:port）。ダッシュボードの使い方に表示します。
GRIDBASE_TUNNEL_SERVER=tunnel.example.com:9443

# ---- 新規登録 ----

# true で新規登録を公開、それ以外（未設定を含む）は閉鎖。既定は閉鎖。
GRIDBASE_SIGNUP_ENABLED=false

# ---- 初回管理者（任意）----

# users に role=admin が 1 人もいないとき、起動時（docker-entrypoint.sh）に 1 回だけ作成します。
# 作成後は削除して構いません。パスワードは 8 文字以上。
GRIDBASE_ADMIN_EMAIL=admin@example.com
GRIDBASE_ADMIN_PASSWORD=change-me-admin-password

# ---- パスワードリセット用 SMTP（任意）----

# SMTP_HOST と SMTP_FROM が両方設定されているときだけ「パスワードを忘れた場合」が有効になります。
# 未設定の場合、画面で案内を表示し、リセットは無効です（ログイン中なら /account でパスワードを変更できます）。
# ポート 465 は暗黙 TLS、それ以外は STARTTLS を使います。
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=smtp-user@example.com
SMTP_PASS=change-me-smtp-password
SMTP_FROM="GridBase <no-reply@example.com>"
